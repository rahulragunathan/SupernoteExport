        <mxCell id="6" value="&lt;b&gt;.note files&lt;/b&gt;&lt;br&gt;&lt;span style='font-style:italic;font-weight:normal;font-size:10px'&gt;Supernote notebooks&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;--input takes any path: a single file, or a folder searched recursively. Read-only; the subfolder tree is mirrored on output.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078d4,#4da3ff);strokeColor=light-dark(#0078d4,#4da3ff);strokeWidth=1;fontColor=light-dark(#ffffff,#08131a);fontSize=12;fontStyle=0;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="280" width="220" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;cli.py / __main__.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-style:italic;font-weight:normal;font-size:10px'&gt;argparse entrypoint&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#34a853;strokeColor=#34a853;strokeWidth=1;fontColor=#ffffff;fontSize=12;fontStyle=0;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="130" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;pipeline.py — run()&lt;/b&gt;&lt;br&gt;&lt;span style='font-style:italic;font-weight:normal;font-size:10px'&gt;Orchestrator → Summary&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#5b3fbf,#b59dff);strokeColor=light-dark(#5b3fbf,#b59dff);strokeWidth=1;fontColor=light-dark(#ffffff,#16122b);fontSize=12;fontStyle=0;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="730" y="130" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;1. discover.py&lt;/b&gt;&lt;br&gt;&lt;span style='font-style:italic;font-weight:normal;font-size:10px'&gt;Resolve --input&lt;/span&gt;&lt;br&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;File or folder → sorted (note, subdir)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#bf8f00,#ffd966);strokeColor=light-dark(#bf8f00,#ffd966);strokeWidth=1;fontColor=light-dark(#ffffff,#241a00);fontSize=12;fontStyle=0;arcSize=10;verticalAlign=middle;align=center;" vertex="1" parent="1">
